{
  "name": "@togetherweown/paperclip-plugin-model-capacity",
  "version": "0.3.0",
  "description": "Native AI connection pool routing with reset-relative per-account pacing. Build-time clean and fork-image transitional variants; no runtime capability toggle.",
  "license": "MIT",
  "type": "module",
  "paperclipPlugin": {
    "manifest": "./src/manifest.mjs",
    "worker": "./src/worker.mjs"
  },
  "files": [
    "src",
    "test",
    "scripts/generate-pool.mjs",
    "scripts/paperclip-api.mjs",
    "scripts/pool-saga.mjs",
    "scripts/pool-plan.mjs",
    "scripts/gateway-batch.mjs",
    "scripts/generator-safety.mjs",
    "scripts/pool-journal.mjs",
    "README.md",
    "LICENSE",
    "config.example.json",
    "scripts/audit-env-pins.mjs"
  ],
  "peerDependencies": {
    "@paperclipai/plugin-sdk": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:public-pin": "node scripts/check-public-pin.mjs",
    "build:variants": "node scripts/build-variants.mjs",
    "audit:env-pins": "node scripts/audit-env-pins.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "4.6.7"
  }
}
